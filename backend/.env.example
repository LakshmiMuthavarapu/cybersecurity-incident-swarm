# Environment Configuration for Cybersecurity Incident Investigation Swarm
# Phase 1: Local Simulated / Synthetic Security Mode

ENVIRONMENT=development
APP_NAME="Cybersecurity Incident Investigation Swarm"
DEBUG=true

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./cyber_swarm.db

# Simulation Guardrails
SIMULATION_MODE=true
ALLOW_REAL_SYSTEM_CHANGES=false

# Future Agent / LLM Configuration (Phase 2 Scaffolding)
# Keep empty or use placeholder for Phase 1. No real credentials required.
GEMINI_API_KEY=placeholder-gemini-api-key-phase2
LLM_MODEL=gemini-2.0-flash
AGENT_MAX_ITERATIONS=10

# API Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000
